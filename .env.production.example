# ============================================
# Production env (.env)
# ============================================
# Үнэхээр шинэ үнэгүй secret үүсгэх:
#   openssl rand -hex 32
# ============================================

# --- Database ---
POSTGRES_USER=app
POSTGRES_PASSWORD=__CHANGE_ME_to_strong_password__
POSTGRES_DB=baby_timelapse

# Migration container болон зэрэг бусад tool-уудын хувьд
DATABASE_URL=postgresql://app:__CHANGE_ME_to_strong_password__@localhost:5432/baby_timelapse

# --- Auth ---
BETTER_AUTH_SECRET=__CHANGE_ME_openssl_rand_hex_32__
BETTER_AUTH_URL=https://your-domain.com
NEXT_PUBLIC_APP_URL=https://your-domain.com

# --- Object Storage (MinIO эсвэл S3-compatible) ---
MINIO_ROOT_USER=app
MINIO_ROOT_PASSWORD=__CHANGE_ME_to_strong_password__
S3_BUCKET=baby-photos

# --- verify.mn (утас баталгаажуулах SMS API) ---
# Developer Console → API KEY. Кодод hardcode хийхгүй.
VERIFY_MN_API_KEY=__CHANGE_ME_verify_mn_api_key__

# Developer Console → RULE ("login") → Prefix (жишээ нь WYL). RULE-ийг
# дахин үүсгэвэл prefix өөрчлөгдөх тул шинэ утгаар шинэчилнэ.
VERIFY_MN_LOGIN_PREFIX=__CHANGE_ME_rule_prefix__

# --- Багцын төлбөр (шилжүүлгийн заавар) ---
# Тавихгүй бол settings-ийн багц хуудсанд "данс тун удахгүй" гэж харагдана.
BILLING_BANK_NAME=__CHANGE_ME_bank_name__
BILLING_BANK_ACCOUNT=__CHANGE_ME_account_number__
BILLING_BANK_HOLDER=__CHANGE_ME_account_holder__
